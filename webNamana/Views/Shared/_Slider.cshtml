<section class="slider_section position-relative">
    <div class="container">
        <div class="custom_nav2">
            <nav class="navbar navbar-expand-lg custom_nav-container">
                <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarSupportedContent"
                        aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarSupportedContent">
                    <div class="d-flex flex-column flex-lg-row align-items-center">
                        <ul class="navbar-nav">
                            <li class="nav-item">
                                <a class="nav-link" href="@Url.Action("Index", "Home")">Home <span class="sr-only">(current)</span></a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="@Url.Action("About", "About")">About</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="@Url.Action("Service", "Service")">Services</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="@Url.Action("Contact", "Contact")">Contact Us</a>
                            </li>
                        </ul>


                        <!-- Кнопка поиска -->
                        <div class="search-box ml-5 position-relative">
                            <form id="searchForm" method="get" action="@Url.Action("ProductPage", "Product")" class="search-form position-relative">
                                <div class="input-group">
                                    <input type="text" id="searchInput" name="query" class="form-control" placeholder="Search..." />
                                    <div class="input-group-append">
                                        <button type="submit" class="btn btn-warning" id="searchButton">
                                            <i class="fas fa-search"></i>
                                        </button>
                                    </div>
                                </div>
                            </form>
                        </div>


                        <!-- Кнопка корзины -->
                        <a href="@Url.Action("CartPage", "CartPage")" class="cart-link ml-lg-4">
                            <i class="fas fa-shopping-cart"></i>
                        </a>

                        <!-- Иконки пользователя и логина справа -->
                        <div class="d-flex ml-lg-4">
                            <!-- Иконка профиля (всегда ведёт на GoToProfile) -->
                            <a href="@Url.Action("GoToProfile", "Account")" class="user-link mr-3" title="Профиль">
                                <i class="fas fa-user-circle user-icon"></i>
                            </a>

                            <!-- Иконка входа (всегда ведёт на Login) -->
                            <a href="@Url.Action("Login", "Account")" class="login-link" title="Вход">
                                <i class="fas fa-sign-in-alt login-icon"></i>
                            </a>
                        </div>

                    </div>
                </div>
            </nav>
        </div>
    </div>
</section>


<!-- Подключение Font Awesome для иконок -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/js/all.min.js"></script>

<style>
    /* Поле поиска — тонкое и округлое */
    .search-form {
        width: 230px;
        max-width: 100%;
    }

        .search-form .form-control {
            height: 34px;
            padding: 4px 10px;
            font-size: 14px;
            border-radius: 25px 0 0 25px;
            border: 1px solid #ccc;
            box-shadow: none;
        }

        .search-form .btn-warning {
            height: 34px;
            padding: 4px 12px;
            font-size: 14px;
            border-radius: 0 25px 25px 0;
            background-color: #ffc107;
            border-color: #ffc107;
        }

        /* Чтобы кнопка не вылазила по высоте */
        .search-form .input-group {
            align-items: center;
        }

    /* Цвет иконок */
    .nav-link i, .cart-link i, .search-link i, .user-link i, .login-link i {
        color: black;
        transition: color 0.3s ease;
    }

        /* При наведении на иконки */
        .nav-link i:hover, .cart-link i:hover, .search-link i:hover, .user-link i:hover, .login-link i:hover {
            color: white;
        }

    /* Для кнопки поиска и корзины */
    .search-link, .cart-link, .user-link, .login-link {
        text-decoration: none;
        color: inherit;
        transition: transform 0.3s ease;
    }

        .search-link:hover, .cart-link:hover, .user-link:hover, .login-link:hover {
            transform: scale(1.1);
        }

    /* Уменьшаем размер иконки пользователя */
    .user-icon {
        font-size: 25px; /* Уменьшаем размер иконки */
    }

    /* Иконка логина - уменьшаем размер, чтобы было как с иконкой корзины */
    .login-icon {
        font-size: 25px; /* Тот же размер, что и у иконки пользователя */
    }

    /* Иконки расположены горизонтально, выравнивание по центру */
    .user-link, .login-link {
        display: flex;
        align-items: center; /* Выравнивание иконок по вертикали */
    }
</style>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const searchForm = document.getElementById("searchForm");
        const searchInput = document.getElementById("searchInput");

        searchForm.addEventListener("submit", function (e) {
            const query = searchInput.value.trim();
            if (query === "") {
                // Перенаправляем на ProductPage без параметров
                e.preventDefault();
                window.location.href = '@Url.Action("ProductPage", "Product")';
            }
            // иначе — форма отправится с query
        });
    });
</script>


