@model webNamana.Models.ChangeRoleViewModel

@{
    ViewBag.Title = "Change User Role";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="box">
    <h2 class="text-center">Change User Role</h2>

    <form method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" name="Id" value="@Model.Id" />

        <div class="form-group">
            <label for="Username">Usernameя</label>
            <input id="Username" name="Username" type="text" class="form-control" value="@Model.Username" readonly />
        </div>

        <div class="form-group mt-2">
            <label for="CurrentRole">Current Role</label>
            <input id="CurrentRole" name="CurrentRole" type="text" class="form-control" value="@Model.CurrentRole" readonly />
        </div>

        <div class="form-group mt-2">
            <label for="NewRole">New Role</label>
            <select id="NewRole" name="NewRole" class="form-control">
                @foreach (var role in Model.AvailableRoles)
                {
                    var selected = role == Model.NewRole ? "selected" : "";
                    <option value="@role" @selected>@role</option>
                }
            </select>
        </div>

        <div class="form-group text-center mt-3">
            <button type="submit" class="btn-1">Save</button>
            <a href="@Url.Action("Clients", "Admin")" class="btn-1 btn-secondary">Cancel</a>
        </div>
    </form>
</div>
