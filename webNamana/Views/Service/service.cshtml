@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "service";
}

<body class="sub_page">
    <div class="hero_area">
    </div>

    <!-- service section -->
    <section class="service_section layout_padding">
        <div class="container">
            <div class="heading_container">
                <h2>
                    Our Services
                </h2>
            </div>
            <div class="service_container">
                <div class="box">
                    <img src="@Url.Content("~/Content/images/s-1.jpg")" alt="TRAINING SCHEDULE">
                    <h6 class="visible_heading">
                         TRAINING SCHEDULE
                    </h6>
                    <div class="link_box">
                        <a href="@Url.Action("Schedule", "Training")">
                            <img src="@Url.Content("~/Content/images/link.png")" alt="TRAINING SCHEDULE">
                        </a>
                        <h6>
                            TRAINING SCHEDULE
                        </h6>
                    </div>
                </div>
                <div class="box">
                    <img src="@Url.Content("~/Content/images/s-2.jpg")" alt="TRAINING REGISTRATION">
                    <h6 class="visible_heading">
                        TRAINING REGISTRATION
                    </h6>
                    <div class="link_box">
                        <a href="@Url.Action("Register", "Training")">
                            <img src="@Url.Content("~/Content/images/link.png")" alt="TRAINING REGISTRATION">
                        </a>
                        <h6>
                            TRAINING REGISTRATION
                        </h6>
                    </div>
                </div>
                <div class="box">
                    <img src="@Url.Content("~/Content/images/s-3.jpg")" alt="BUY SUBSCRIPTION">
                    <h6 class="visible_heading">
                        BUY SUBSCRIPTION
                    </h6>
                    <div class="link_box">
                        <a href="@Url.Action("SubscriptionPurchase", "SubscriptionPurchase")">
                            <img src="@Url.Content("~/Content/images/link.png")" alt="BUY SUBSCRIPTION">
                        </a>
                        <h6>
                            BUY SUBSCRIPTION
                        </h6>
                    </div>
                </div>
                <div class="box">
                    <img src="@Url.Content("~/Content/images/s-4.jpg")" alt="SHOP">
                    <h6 class="visible_heading">
                        SHOP
                    </h6>
                    <div class="link_box">
                        <a href="@Url.Action("ProductPage", "Product")">
                            <img src="@Url.Content("~/Content/images/link.png")" alt="SHOP">
                        </a>
                        <h6>
                            SHOP
                        </h6>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <!-- end service section -->
</body>
