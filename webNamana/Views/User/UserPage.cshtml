@model webNamana.Models.UserDashboard
@using System.Linq

@{
    ViewBag.Title = "User Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-5">
    <div class="row">
        <!-- Profile Section -->
        <div class="col-md-4">
            <div class="card">
                <div class="card-header">
                    <h3>Profile</h3>
                </div>
                <div class="card-body text-center">
                    <!-- Avatar -->
                    <img src="@Url.Content("~/Content/Avatars/" + Model.Username + ".png")"
                         onerror="this.src='@Url.Content("~/Content/Images/placeholder-profile.png")'"
                         alt="Profile Picture"
                         class="img-fluid rounded-circle"
                         style="width: 150px; height: 150px;" />

                    <h4 class="mt-3">@Model.Username</h4>
                    <p>@Model.Email</p>

                    <!-- Avatar Upload -->
                    @using (Html.BeginForm("UploadAvatar", "User", FormMethod.Post, new { enctype = "multipart/form-data" }))
                    {
                        <div class="form-group mt-3">
                            <input type="file" name="avatar" class="form-control-file" />
                            <button type="submit" class="btn btn-outline-primary btn-sm mt-2">Upload Avatar</button>
                        </div>
                    }
                </div>
            </div>

           

            <!-- Cart -->
            <div class="card mt-3">
                <div class="card-header">
                    <h3>Your Cart</h3>
                </div>
                <div class="card-body">
                    <ul>
                        @foreach (var item in Model.CartItems)
                        {
                            <li>@item</li>
                        }
                    </ul>
                    <a href="@Url.Action("Cart", "User")" class="btn btn-outline-secondary btn-sm mt-2">View Cart</a>
                </div>
            </div>
        </div>

        <!-- Actions Section -->
        <div class="col-md-8">
            <div class="card">
                <div class="card-header">
                    <h3>Actions</h3>
                </div>
                <div class="card-body">
                    <a href="@Url.Action("EditProfile", "User")" class="btn btn-primary mb-2">Edit Profile</a>
                    <a href="@Url.Action("ViewOrders", "User")" class="btn btn-secondary mb-2">View Orders</a>
                    <a href="@Url.Action("ChangePassword", "User")" class="btn btn-warning mb-2">Change Password</a>
                </div>
            </div>
        </div>
    </div>
</div>
