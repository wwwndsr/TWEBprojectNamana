@model webNamana.Models.UserDashboard
@using System.Linq

@{
    ViewBag.Title = "User Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-5">
    <div class="row">
        <!-- Profile Section -->
        <div class="col-md-4">
            <div class="card">
                <div class="card-header">
                    <h3>Profile</h3>
                </div>
                <div class="card-body text-center">
                    <!-- Статичное изображение -->
                    <img src="@Url.Content("~/Content/Images/placeholder-profile.png")"
                         alt="Profile Picture"
                         class="img-fluid rounded-circle"
                         style="width: 150px; height: 150px;" />

                    <h4 class="mt-3">@Model.Username</h4>
                    <p>@Model.Email</p>
                </div>
            </div>

            <!-- Cart -->
            <div class="card mt-3">
                <div class="card-header">
                    <h3>Your Cart</h3>
                </div>
                <div class="card-body">
                    @if (Model.CartItems != null && Model.CartItems.Count > 0)
                    {
                        <ul>
                            @foreach (var item in Model.CartItems)
                            {
                                <li>@item</li>
                            }
                        </ul>
                    }
                    else
                    {
                        <p>Your cart is empty.</p>
                    }

                    <a href="@Url.Action("CartPage", "CartPage")" class="btn btn-outline-secondary btn-sm mt-2">View Cart</a>
                </div>
            </div>
        </div>

        <!-- Actions Section -->
        <div class="col-md-8">
            <div class="card">
                <div class="card-header">
                    <h3>Actions</h3>
                </div>
                <div class="card-body">
                    <a href="@Url.Action("EditProfile", "User")" class="btn btn-primary mb-2">Edit Profile</a>
                    <a href="@Url.Action("ViewOrders", "User")" class="btn btn-secondary mb-2">View Orders</a>
                    <a href="@Url.Action("ChangePassword", "User")" class="btn btn-warning mb-2">Change Password</a>
                    <a href="@Url.Action("Logout", "Account")" class="btn btn-danger mb-2">Logout</a>
                </div>
            </div>
        </div>
    </div>
</div>
