@model webNamana.Models.UserDashboard
@using System.Linq

@{
    ViewBag.Title = "User Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .card-custom {
        background-color: white;
        border-radius: 15px;
        box-shadow: 0 5px 25px rgba(0, 0, 0, 0.05);
        padding: 25px 30px;
        margin-bottom: 30px;
    }

    .btn-custom {
        width: 100%;
        padding: 12px;
        font-weight: 600;
        border-radius: 10px;
        transition: all 0.3s ease;
        font-size: 1rem;
    }

    .btn-custom:hover {
        transform: translateY(-2px);
        opacity: 0.9;
    }

    .btn-primary {
        background-color: #007bff;
        color: white;
    }

    .btn-warning {
        background-color: #ffc107;
        color: black;
    }

    .btn-danger {
        background-color: #dc3545;
        color: white;
    }

    .btn-outline-secondary {
        border-color: #6c757d;
        color: #6c757d;
    }

    .btn-outline-secondary:hover {
        background-color: #6c757d;
        color: white;
    }

    /* Профиль с иконкой */
    .profile-icon {
        width: 150px;
        height: 150px;
        background-color: #007bff;
        color: white;
        font-size: 72px;
        font-weight: 700;
        line-height: 150px;
        border-radius: 50%;
        text-align: center;
        user-select: none;
        margin: 0 auto 15px auto;
        box-shadow: 0 4px 10px rgba(0,0,0,0.1);
    }

    .profile-username {
        font-size: 1.5rem;
        font-weight: 600;
        margin-bottom: 5px;
    }

    .text-muted {
        color: #6c757d !important;
    }

    ul.list-unstyled.text-left {
        padding-left: 0;
        list-style: none;
        margin-top: 10px;
    }

    ul.list-unstyled.text-left li {
        font-size: 1rem;
        padding: 4px 0;
    }

    ul.list-group.list-group-flush {
        margin-top: 15px;
    }

    ul.list-group.list-group-flush li {
        font-size: 1rem;
        padding: 10px 15px;
        border-bottom: 1px solid #eee;
    }

    .text-success {
        color: #28a745 !important;
        font-weight: 600;
    }

    .text-warning {
        color: #ffc107 !important;
        font-weight: 600;
    }

    /* Адаптивность */
    @@media (max-width: 767.98px) {
        .btn-custom {
            font-size: 0.9rem;
            padding: 10px;
        }
    }
</style>

<div class="container mt-5">
    <div class="row">

        <!-- Profile Panel -->
        <div class="col-md-4">
            <div class="card-custom text-center">
                <!-- Иконка с первой буквой -->
                <div class="profile-icon">
                    @(!string.IsNullOrEmpty(Model.Username) ? Model.Username.Substring(0, 1).ToUpper() : "?")
                </div>

                <div class="profile-username">@Model.Username</div>
                <p class="text-muted">@Model.Email</p>

                <hr />

                <h5>Your Cart</h5>

                @if (Model.CartItems != null && Model.CartItems.Count > 0)
                {
                    <ul class="list-unstyled text-left">
                        @foreach (var item in Model.CartItems)
                        {
                            <li><i class="fas fa-check-circle text-success me-1"></i> @item</li>
                        }
                    </ul>
                }
                else
                {
                    <p class="text-muted">Your cart is empty.</p>
                }

                <a href="@Url.Action("CartPage", "CartPage")" class="btn btn-outline-secondary btn-sm mt-3">View Cart</a>
            </div>
        </div>

        <!-- Trainings Section -->
        <div class="col-md-8">
            <div class="card-custom">
                <h5>Your Trainings</h5>

                @if (Model.Trainings != null && Model.Trainings.Count > 0)
                {
                    <ul class="list-group list-group-flush">
                        @foreach (var training in Model.Trainings)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <div>
                                    <i class="fas fa-dumbbell text-primary me-2"></i>
                                    <strong>@training.TrainingType</strong> on
                                    <span>@training.RegistrationDate.ToString("dd.MM.yyyy")</span> at
                                    <span>@training.TrainingTime.ToString(@"hh\:mm")</span>
                                </div>
                                <div>
                                    @if (training.IsConfirmed)
                                    {
                                        <span class="text-success">Confirmed</span>
                                    }
                                    else
                                    {
                                        <span class="text-warning">Pending</span>
                                    }
                                </div>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <p class="text-muted">You have no training registrations yet.</p>
                }
            </div>

            <div class="card-custom mt-4">
                <h3 class="mb-4">Account Actions</h3>

                <div class="row gy-3">
                    <div class="col-sm-6">
                        <a href="@Url.Action("EditProfile", "User")" class="btn btn-custom btn-primary">Edit Profile</a>
                    </div>
                    <div class="col-sm-6">
                        <a href="@Url.Action("ChangePassword", "User")" class="btn btn-custom btn-warning">Change Password</a>
                    </div>
                    <div class="col-sm-6">
                        <a href="@Url.Action("Logout", "Account")" class="btn btn-custom btn-danger">Logout</a>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>
