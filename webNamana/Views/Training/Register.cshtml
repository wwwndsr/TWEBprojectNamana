@model webNamana.Models.TrainingRegisterViewModel
@{
    ViewBag.Title = "Запись на тренировку";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var availableTrainings = ViewBag.AvailableTrainings as List<string> ?? new List<string>();
    var availableTimes = ViewBag.AvailableTimes as List<System.DateTime> ?? new List<System.DateTime>();
    var selectedTraining = ViewBag.SelectedTraining as string ?? "";
    var selectedDateTime = ViewBag.SelectedDateTime as string ?? "";

    var isUserLoggedIn = Session["User"] != null;
    var user = isUserLoggedIn ? (webNamana.Domain.Entities.User.UserMinimal)Session["User"] : null;
}
<div class="container mt-5">
    <div class="card shadow-lg p-4" style="max-width: 650px; margin: 0 auto; border: 2px solid gold;">
        <h2 class="text-center mb-4">Запись на тренировку</h2>

        <form method="post" action="@Url.Action("Register", "Training")">
            @Html.AntiForgeryToken()

            @if (user != null)
            {
                <div class="alert alert-info text-center">
                    Вы вошли как <strong>@user.Username</strong>
                </div>
            }

            <div class="mb-3">
                <label class="form-label">Тип тренировки</label>
                <select name="TrainingType" class="form-control" required>
                    <option value="">-- Выберите --</option>
                    @foreach (var training in availableTrainings)
                    {
                        var selected = training == Model.TrainingType ? "selected" : "";
                        <option value="@training" @selected>@training</option>
                    }
                </select>
            </div>

            <div class="mb-3">
                <label class="form-label">Дата и время</label>
                <select name="TrainingDateTime" class="form-control" required>
                    <option value="">-- Выберите --</option>
                    @foreach (var time in availableTimes)
                    {
                        var formattedValue = time.ToString("yyyy-MM-ddTHH:mm");
                        var isSelected = formattedValue == selectedDateTime ? "selected" : "";
                        <option value="@formattedValue" @isSelected>
                            @time.ToString("dd.MM.yyyy HH:mm")
                        </option>
                    }
                </select>
            </div>

            <button type="submit" class="btn w-100 mt-3" style="background-color: gold; color: black; font-weight: bold;">
                Подтвердить регистрацию
            </button>
        </form>
    </div>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
