@model List<webNamana.Domain.Entities.Training.TrainingEntity>

@{
    ViewBag.Title = "Training Schedule";

    DayOfWeek[] daysOfWeek = new DayOfWeek[]
    {
        DayOfWeek.Monday,
        DayOfWeek.Tuesday,
        DayOfWeek.Wednesday,
        DayOfWeek.Thursday,
        DayOfWeek.Friday,
        DayOfWeek.Saturday,
        DayOfWeek.Sunday
            };
}

<h2>Training Schedule</h2>


<style>
    body {
        font-family: "Source Sans Pro", sans-serif;
        background: #fff;
        margin: 0;
        padding: 0;
        color: #222;
    }

    .schedule-container {
        display: grid;
        grid-template-columns: 60px 1fr;
        max-width: 1400px;
        margin: 2em auto;
        gap: 10px;
    }

    .timeline {
        display: flex;
        flex-direction: column;
        gap: 30px;
        padding-top: 50px;
        font-size: 14px;
        align-items: center;
    }

    .days {
        display: grid;
        grid-template-columns: repeat(7, 1fr);
        border: 1px solid #EAEAEA;
    }

    .day-column {
        border-left: 1px solid #EAEAEA;
        position: relative;
        padding-top: 50px;
    }

    .day-header {
        position: absolute;
        top: 0;
        width: 100%;
        text-align: center;
        background: #f7f7f7;
        padding: 10px 5px;
        border-bottom: 1px solid #EAEAEA;
        font-weight: bold;
    }

    .event {
        position: absolute;
        left: 10%;
        right: 10%;
        background-color: #577F92;
        color: #fff;
        padding: 10px;
        border-radius: 8px;
        box-shadow: 0 2px 6px rgba(0, 0, 0, 0.15);
        font-size: 14px;
        text-align: center;
    }

        .event[data-color="1"] {
            background-color: #577F92;
        }

        .event[data-color="2"] {
            background-color: #443453;
        }

        .event[data-color="3"] {
            background-color: #A2B9B2;
        }

        .event[data-color="4"] {
            background-color: #f6b067;
        }

        .event a {
            color: white;
            text-decoration: none;
            display: block;
            width: 100%;
            height: 100%;
        }

            .event a:hover {
                text-decoration: underline;
            }

    @@media (max-width: 800px) {
        .schedule-container {
            grid-template-columns: 1fr;
        }

        .timeline {
            display: none;
        }

        .days {
            grid-template-columns: 1fr;
        }

        .day-column {
            min-height: 400px;
            margin-bottom: 20px;
        }
    }
</style>

<div class="schedule-container">
    <div class="timeline">
        @for (int hour = 9; hour <= 18; hour++)
        {
            <span>@hour:00</span>
        }
    </div>

    <div class="days">
        @foreach (DayOfWeek day in daysOfWeek)
        {
            <div class="day-column">
                <div class="day-header">@day</div>

                @foreach (var training in Model)
                {
                    if (training.DayOfWeek == day)
                    {
                        int topPercent = (training.StartTime.Hours - 9) * 10 + (training.StartTime.Minutes * 10 / 60);
                       <div class="event" style="top:@(topPercent)%" data-color="1">

                            <a href="@Url.Action("Register", "TrainingRegistration", new { training = training.TrainingName, time = training.StartTime.ToString(@"hh\:mm") })">
                                @training.TrainingName
                            </a>
                        </div>
                    }
                }
            </div>
        }
    </div>
</div>