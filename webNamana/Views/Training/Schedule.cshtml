@model List<webNamana.Models.TrainingListViewModel>

@{
    ViewBag.Title = "Training Schedule";

    DayOfWeek[] daysOfWeek = new DayOfWeek[]
    {
        DayOfWeek.Monday,
        DayOfWeek.Tuesday,
        DayOfWeek.Wednesday,
        DayOfWeek.Thursday,
        DayOfWeek.Friday,
        DayOfWeek.Saturday,
        DayOfWeek.Sunday
            };

    int hourHeight = 70;    // Высота одного часа в пикселях
    int headerHeight = 50;  // Высота заголовка дня
}

<h2>Training Schedule</h2>

<style>
    body {
        font-family: "Source Sans Pro", sans-serif;
        background: #fff;
        margin: 0;
        padding: 0;
        color: #222;
    }

    .schedule-container {
        display: grid;
        grid-template-columns: 60px 1fr;
        max-width: 1400px;
        margin: 2em auto;
        gap: 10px;
    }

    .timeline {
        display: flex;
        flex-direction: column;
        gap: 70px; /* Высота часа */
        padding-top: 50px;
        font-size: 14px;
        align-items: center;
        user-select: none;
    }

    .days {
        display: grid;
        grid-template-columns: repeat(7, 1fr);
        border: 1px solid #EAEAEA;
    }

    .day-column {
        position: relative;
        padding-top: 50px; /* Отступ под заголовок */
        height: 630px; /* 9 часов * 70px */
        border-left: 1px solid #EAEAEA;
        background: #fafafa;
        box-sizing: border-box;
    }

    .day-header {
        position: absolute;
        top: 0;
        height: 50px;
        width: 100%;
        text-align: center;
        background: #f7f7f7;
        padding: 10px 5px;
        border-bottom: 1px solid #EAEAEA;
        font-weight: bold;
        line-height: 30px;
        box-sizing: border-box;
    }

    .event {
        position: absolute;
        left: 10%;
        right: 10%;
        color: #fff;
        padding: 8px 6px;
        border-radius: 8px;
        box-shadow: 0 2px 6px rgba(0, 0, 0, 0.15);
        font-size: 14px;
        text-align: center;
        cursor: pointer;
        box-sizing: border-box;
    }

        .event[data-color="1"] {
            background-color: #577F92;
        }
        /* default */
        .event[data-color="2"] {
            background-color: #f67e7d;
        }
        /* Pilates - красный */
        .event[data-color="3"] {
            background-color: #7ac7c4;
        }
        /* Yoga - бирюзовый */

        .event a {
            color: white;
            text-decoration: none;
            display: block;
            width: 100%;
            height: 100%;
        }

            .event a:hover {
                text-decoration: underline;
            }

    /* Медиазапрос */
    @@media (max-width: 800px) {
        .schedule-container {
            grid-template-columns: 1fr;
        }

        .timeline {
            display: none;
        }

        .days {
            grid-template-columns: 1fr;
        }

        .day-column {
            min-height: 400px;
            margin-bottom: 20px;
        }
    }
</style>

<div class="schedule-container">
    <div class="timeline">
        @for (int hour = 9; hour <= 18; hour++)
        {
            <span>@hour:00</span>
        }
    </div>

    <div class="days">
        @foreach (DayOfWeek day in daysOfWeek)
        {
            <div class="day-column">
                <div class="day-header">@day</div>

                @foreach (var training in Model)
                {
                    if (training.DayOfWeek == day)
                    {
                        int topPx = headerHeight + (training.StartTime.Hours - 9) * hourHeight + (training.StartTime.Minutes * hourHeight / 60);

                        string colorCode = "1"; // дефолтный цвет

                        if (training.TrainingName != null)
                        {
                            var nameLower = training.TrainingName.ToLower();

                            if (nameLower == "pilates")
                            {
                                colorCode = "2";
                            }
                            else if (nameLower == "yoga")
                            {
                                colorCode = "3";
                            }
                        }

                        <div class="event" style="top:@(topPx)px;" data-color="@colorCode">
                            <a href="@Url.Action("Register", "Training", new { training = training.TrainingName, time = training.StartTime.ToString(@"hh\:mm") })">
                                @training.TrainingName
                            </a>
                        </div>
                    }
                }
            </div>
        }
    </div>
</div>
