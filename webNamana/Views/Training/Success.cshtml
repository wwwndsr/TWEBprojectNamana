@{
    ViewBag.Title = "Registration Successful";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-5">
    <div class="alert alert-success text-center" style="border: 2px solid gold;">
        <h2 class="mb-3">Successful Registration!</h2>
        <p>@TempData["SuccessMessage"]</p>
        <a href="@Url.Action("Register", "Training")" class="btn" style="background-color: gold; color: black; font-weight: bold; margin-right: 10px;">
            Register again
        </a>
        <a href="@Url.Action("Schedule", "Training")" class="btn btn-outline-dark">
            Back to Schedule
        </a>
    </div>
</div>
