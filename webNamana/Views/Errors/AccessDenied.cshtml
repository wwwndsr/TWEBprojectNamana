@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Access Denied";
}

<div class="container text-center mt-5">
    <h1 class="display-3 text-warning">403</h1>
    <h2 class="mb-3">Доступ запрещён</h2>
    <p class="text-muted">У вас нет прав для просмотра этой страницы.</p>
    <a href="@Url.Action("Login", "Account")" class="btn btn-warning mt-3">Войти с другим аккаунтом</a>
</div>
