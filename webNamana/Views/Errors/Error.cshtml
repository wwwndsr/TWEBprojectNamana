@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Server Error";
}

<div class="container text-center mt-5">
    <h1 class="display-3 text-danger">500</h1>
    <h2 class="mb-3">Внутренняя ошибка сервера</h2>
    <p class="text-muted">Произошла непредвиденная ошибка. Мы уже работаем над её устранением.</p>
    <a href="@Url.Action("Index", "Home")" class="btn btn-secondary mt-3">Вернуться на главную</a>
</div>
